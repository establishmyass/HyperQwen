 import functools
+
+import torch
+
+
+def offload_lookup_sm89(table: torch.Tensor) -> None:
+    """Keep a read-only lookup table in pinned RAM and gather its selected rows on Ada."""
+    from vllm.platforms import current_platform
+    from vllm.utils.torch_utils import get_accelerator_view_from_cpu_tensor
+
+    if current_platform.is_device_capability(89) and not getattr(table, "_vllm_is_uva_offloaded", False):
+        host = table.detach().to(device="cpu").pin_memory()
+        table.data = get_accelerator_view_from_cpu_tensor(host)
+        table._vllm_is_uva_offloaded = True
 
 
